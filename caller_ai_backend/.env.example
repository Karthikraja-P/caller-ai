# ============================================================
# Caller AI Backend - Environment Variables
# Copy to .env and fill in real values. Never commit .env!
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Google Cloud TTS ---
GOOGLE_TTS_API_KEY=AIza...
GOOGLE_CREDENTIALS_JSON=/path/to/service-account.json

# --- WhatsApp Business API ---
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=EAAxxxxx...
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxx

# --- Caller ID Providers ---
TELNYX_API_KEY=KEY0...
TRESTLEIQ_API_KEY=your_trestleiq_key
APIFY_API_TOKEN=apify_api_...

# --- Google AdMob ---
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# --- Firebase ---
FIREBASE_SERVER_KEY=AAAAxxxxxxx:APA91b...

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RevenueCat ---
REVENUECAT_API_KEY=appl_xxxxxxxxxxxxxxxx

# --- Mixpanel ---
MIXPANEL_TOKEN=your_mixpanel_project_token

# --- Meilisearch ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# --- App Config ---
APP_ENV=development
APP_VERSION=2.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-prod
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
